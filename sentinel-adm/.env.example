# ============================================
# SENTINEL-ADM — environment template
# ============================================
# Copy to .env (gitignored) and fill in. Secrets never belong in git.

# Runtime
SENTINEL_ENV=on-prem

# ── Inference (OpenAI-compatible; local or external) ─────────────────────────
# Leave LLM_BASE_URL empty to run every deterministic engine offline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_JSON_SCHEMA_STRICT=true

# ── Local state ──────────────────────────────────────────────────────────────
# Local watchlist (deposits, fuel stations, distributors, transport contractors).
WATCHLIST_PATH=/data/watchlist/watchlist.json
WATCHLIST_FUZZY_THRESHOLD=0.88

# ── Notifications ────────────────────────────────────────────────────────────
SENTINEL_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=

# ── News radar sources (comma separated RSS/press-room URLs) ─────────────────
SENTINEL_NEWS_FEEDS=https://www.gdf.gov.it/rss,https://www.adm.gov.it/rss

# ── Production proxy (compose profile "prod") ────────────────────────────────
# Public deployment: real domain + ACME contact (deploy/Caddyfile).
# Internal/LAN deployment: set SENTINEL_CADDYFILE=Caddyfile.internal and any
# hostname; Caddy will issue certificates from its own local CA.
SENTINEL_DOMAIN=sentinel.example.org
SENTINEL_ACME_EMAIL=
SENTINEL_CADDYFILE=Caddyfile
SENTINEL_BASIC_AUTH_USER=adm
# Generated by scripts/bootstrap.sh from SENTINEL_BASIC_AUTH_PASSWORD.
# Stored with every $ doubled ($$2a$$14$$...): compose interpolation would
# otherwise eat the $-segments of the bcrypt hash.
SENTINEL_BASIC_AUTH_HASH=

# Published ports bind to 127.0.0.1 (proxy-only) by default; widen to 0.0.0.0
# only on a trusted development LAN, and never without authentication.
SENTINEL_BIND_IP=127.0.0.1
SENTINEL_API_PORT=8080
SENTINEL_UI_PORT=8501
SENTINEL_HTTP_PORT=80
SENTINEL_HTTPS_PORT=443

# ── jwilder/nginx-proxy mode (compose profile "jwilder") ─────────────────────
# Same pattern as the worldmonitor stack: the external proxy terminates TLS via
# the acme-companion and routes by VIRTUAL_HOST; no host ports are published.
# Requires the shared network: docker network create nginx-proxy
SENTINEL_VIRTUAL_HOST=osint.risksentinel.opencyber.org
LETSENCRYPT_EMAIL=info@opencyber.org

# ── Backups (read by scripts/backup.sh) ──────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION=14
