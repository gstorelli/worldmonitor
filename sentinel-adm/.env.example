# ============================================
# SENTINEL-ADM — environment template
# ============================================
# Copy to .env (gitignored) and fill in. Secrets never belong in git.

# Runtime
SENTINEL_ENV=on-prem

# ── Inference (OpenAI-compatible; local or external) ─────────────────────────
# Leave LLM_BASE_URL empty to run every deterministic engine offline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_JSON_SCHEMA_STRICT=true

# ── Local services ───────────────────────────────────────────────────────────
YENTE_URL=http://yente:8000
YENTE_DATASET=default
YENTE_INDEX_TYPE=sqlite
YENTE_UPDATE_TOKEN=
ARCHIVEBOX_URL=http://archivebox:8000
ARCHIVEBOX_OUTPUT_DIR=/data/archivebox
EVIDENCE_DIR=/data/evidence

# ── RFC 3161 timestamp authority ─────────────────────────────────────────────
# Point to a qualified TSA for judicial use (freetsa is a public test service).
TSA_URL=https://freetsa.org/tsr

# ── Matching thresholds (0-1) ────────────────────────────────────────────────
SANCTIONS_MATCH_THRESHOLD=0.7
SANCTIONS_FLASH_THRESHOLD=0.9
WATCHLIST_FUZZY_THRESHOLD=0.88

# ── Notifications ────────────────────────────────────────────────────────────
SENTINEL_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=

# ── News radar sources (comma separated RSS/press-room URLs) ─────────────────
SENTINEL_NEWS_FEEDS=https://www.gdf.gov.it/rss,https://www.adm.gov.it/rss
