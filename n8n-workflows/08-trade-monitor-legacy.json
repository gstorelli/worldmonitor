        "fieldsToMatchString": "title,link, pubDate, content, contentSnippet, guid, isoDate",
        "joinMode": "keepNonMatches",
        "options": {}
      },
      "name": "Merge Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        688,
        304
      ],
      "id": "8204aa14-12da-4610-8fed-ea9c6db147c1"
    },
    {
      "parameters": {
        "jsCode": "const CRITICAL=[\"blockade\",\"closure\",\"attack\",\"severe\",\"crisis\",\"war\"];const HIGH=[\"disruption\",\"shortage\",\"strike\",\"surge\",\"tension\",\"conflict\",\"ban\"];const MEDIUM=[\"delay\",\"congestion\",\"volatility\",\"concern\",\"warning\",\"risk\"];const ROUTES=[\"Suez\",\"Panama\",\"Hormuz\",\"Malacca\",\"Taiwan\",\"Red Sea\",\"Black Sea\"];return items.map(i=>{const t=JSON.stringify(i.json||\"\").toLowerCase();let l=\"LOW\",s=10;for(const k of CRITICAL)if(t.includes(k)){l=\"CRITICAL\";s=90;break}if(s<70)for(const k of HIGH)if(t.includes(k)){l=\"HIGH\";s=60}if(s<40)for(const k of MEDIUM)if(t.includes(k)){l=\"MEDIUM\";s=35}for(const r of ROUTES)if(t.includes(r.toLowerCase()))s=Math.min(100,s+15);return{json:{...i.json,risk_level:l,risk_score:s}}})"
      },
      "name": "Risk Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        864,
        304
      ],
      "id": "966b1cce-4824-4892-9ee4-4f4516c996e1"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.risk_score}}",
              "operation": "larger",
              "value2": 40
            }
          ]
        }
      },
      "name": "Filter >40",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1088,
        304
      ],
      "id": "97abde5c-a8e9-4353-90b6-0034d1c11296"
    },
    {
      "parameters": {
        "jsCode": "return $('Filter >40').all().map(i=>({json:{alert:{type:\"risk_sentinel\",level:i.json.risk_level,score:i.json.risk_score,title:i.json.title||\"\",link:i.json.link||\"\",source:i.json.creator||\"\",date:i.json.isoDate||new Date().toISOString()}}}))"
      },
      "name": "Format Alert",
