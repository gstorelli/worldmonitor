    {
      "parameters": {
        "url": "https://news.google.com/rss/search?q=(\"Panama+Canal\"+OR+\"Strait+of+Hormuz\"+OR+Malacca+OR+\"Taiwan+Strait\")+when:2d&hl=en-US&gl=US&ceid=US:en",
        "options": {}
      },
      "id": "51f04322-0423-4609-9aa4-b42431367f28",
      "name": "Feed: Chokepoints",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        224,
        384
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.title }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Sei un analista di rischi doganali e supply chain. Analizza il titolo della notizia e produci un assessment di rischio. CRITICAL: chiusura/blocco immediato. HIGH: disruption grave in corso. MEDIUM: tensione/preoccupazione. LOW: news informativa. Output SOLO JSON valido.",
          "maxIterations": 1
        }
      },
      "id": "3d22e365-86ff-4f4a-9aad-180bb6967c0e",
      "name": "LLM Risk Analyzer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "model": "deepseek/deepseek-v4-flash",
        "options": {
          "maxTokens": 300,
          "responseFormat": "json_object",
          "temperature": 0.1
        }
      },
      "id": "a64786a4-7cfe-47df-96da-fe8986e42863",
      "name": "DeepSeek V4 Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        688,
        416
      ],
      "credentials": {
        "openRouterApi": {
          "id": "f3zGtD9qJ3lDDtCe",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"risk_level\":\"MEDIUM\",\"risk_score\":45,\"summary_it\":\"Riassunto in italiano della notizia\",\"chokepoint\":\"Nessuno\",\"entities\":[\"Iran\",\"tanker\"],\"recommendation\":\"Monitorare\"}",
        "autoFix": true
      },
      "id": "1de8813d-06ae-450b-9b02-4431fe968b2f",
      "name": "Risk Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        864,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output || $json;\nreturn [{\n  json: {\n    title: $json.title || '',\n    link: $json.link || '',\n    risk_level: out.risk_level || 'MEDIUM',\n    risk_score: out.risk_score || 30,\n    summary_it: out.summary_it || '',\n    chokepoint: out.chokepoint || 'Nessuno',\n    entities: (out.entities || []).join(', '),\n    recommendation: out.recommendation || 'Monitor',\n    isoDate: $json.isoDate || new Date().toISOString()\n  }\n}];"
      },
      "id": "935e3f30-44b1-48c8-97aa-646ae8e71bb1",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.risk_score }}",
              "rightValue": 40,
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b1bdd6e-e1f9-480e-a11a-eefd909dc22a",
      "name": "Filter >=40",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1248,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "console.log('[Risk Sentinel]', $json.risk_level, '(' + $json.risk_score + '/100) -', $json.summary_it);\nreturn [{ json: $json }];"
      },
      "id": "d7afa436-cca6-4b2f-852d-95f3b8da55c8",
      "name": "Log Alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        192
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "https://docs.google.com/spreadsheets/d/1Rckb4SQUGK7koBWuC9scgFTK3DqxJHuwxkmgfbFExPE/edit"
        },
