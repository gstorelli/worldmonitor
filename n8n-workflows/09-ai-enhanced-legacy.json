        "options": {}
      },
      "id": "72b37a3c-3bd2-4fa6-9e77-4dd5a6b0bf95",
      "name": "Feed: Shipping",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
